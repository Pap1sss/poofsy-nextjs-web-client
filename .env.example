NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Poofsy"
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_APP_DESCRIPTION="Money comes, money goes… poof!"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API base URL. Browser requests go through the /api rewrite in next.config.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Must match REVERB_APP_KEY / REVERB_PORT / REVERB_SCHEME in the API's .env.
NEXT_PUBLIC_REVERB_APP_KEY=local-app-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
